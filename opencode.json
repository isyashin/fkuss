{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "snapshot": true,
  "share": "disabled",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "edit": "allow",
    "external_directory": {
      "*": "ask"
    },
    "bash": {
      "*": "ask",
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git add *": "allow"
    }
  },
  "agent": {
    "build": {
      "description": "Основной агент разработки шаблона"
    }
  }
}
