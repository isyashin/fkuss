POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://resto:replace-with-local-password@localhost:5432/resto
# Первого владельца создайте после миграции командой bootstrap-admin.ts;
# ADMIN_BOOTSTRAP_LOGIN/NAME/PASSWORD передавайте только этой команде.
CRON_SECRET=replace-with-local-cron-secret
AUTH_DEV_CODE=1
INSECURE_HTTP=1
PLATFORM_PUBLIC_URL=http://localhost:3100

# ТОЛЬКО для dev/тестов: вход гостя в ЛК без почтового кода (POST /api/auth/dev-login).
# На prod НЕ устанавливать — вход станет безпарольным для любого email.
DEV_GUEST_LOGIN=1

# Яндекс.Карты. JS API — карта в браузере (админка/витрина), виден посетителям.
# HTTP Геокодер — серверный (geocode-maps.yandex.ru/v1), нужен для авто-зон доставки.
# Можно указать один ключ на оба. Без геокодера режим зон на карте не включается.
YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_API_KEY=

# Web push админки (VAPID). Ключи — per-site, генерируются deploy.sh автоматически;
# существующим сайтам — scripts/backfill-vapid-keys.sh. Публичный ключ НЕ печать
# в NEXT_PUBLIC_*: образ общий, ключ отдаётся runtime-эндпоинтом /api/admin/push/config.
# Пока пара ключей не задана, push выключен (флаг включения — сама пара ключей).
# Ротация ключей требует повторного включения уведомлений на всех устройствах.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт для push-провайдеров, виден в метаданных VAPID (mailto:).
VAPID_SUBJECT=mailto:push@fkuss.ru

