// Шаблон сайта ресторана — модель данных
// Детали: docs/PLAN.md (этап 2), docs/ARCHITECTURE.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id         String  @id
  name       String
  position   Int     @default(0)
  externalId String? @unique // внешний ID Яндекс.Еды (сопоставление при синхронизации)
  dishes     Dish[]
}

model Dish {
  id                String     @id
  categoryId        String
  category          Category   @relation(fields: [categoryId], references: [id])
  name              String
  description       String     @default("")
  price             Int        // рассчитанная цена (только она видна серверу заказа)
  image             String     @default("")
  weight            String     @default("")
  tags              String[]
  available         Boolean    @default(true) // вычисленная: manualAvailable && yandexAvailable (для yandex-блюд)
  position          Int        @default(0)
  // Источник и синхронизация
  source            String     @default("manual") // manual | yandex
  externalId        String?    @unique // внешний ID Яндекс.Еды
  lastSyncedAt      DateTime?
  // Доступность
  manualAvailable   Boolean    @default(true) // ручной рубильник админа
  yandexAvailable   Boolean    @default(true) // доступность по данным Яндекс.Еды
  // Цены
  yandexPrice       Int?       // базовая цена из Яндекс.Еды
  manualPrice       Int?       // ручная цена админа
  priceMode         String     @default("inherit") // inherit | yandex | manual | coefficient
  coefficientPercent Int?      // индивидуальный коэффициент в %
  modifierGroups    ModifierGroup[]
  modifiers         Modifier[]
}

model ModifierGroup {
  id          String   @id
  dishId      String
  dish        Dish     @relation(fields: [dishId], references: [id])
  externalId  String?
  name        String
  position    Int      @default(0)
  minSelected Int      @default(0)
  maxSelected Int      @default(1)
  modifiers   Modifier[]
}

model Modifier {
  id          String  @id
  dishId      String
  dish        Dish    @relation(fields: [dishId], references: [id])
  groupId     String?
  group       ModifierGroup? @relation(fields: [groupId], references: [id])
  externalId  String?
  name        String
  price       Int     // рассчитанная цена
  yandexPrice Int?
  manualPrice Int?
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String   @default("")
  name      String   @default("")
  createdAt DateTime @default(now())
  authCodes AuthCode[]
  addresses Address[]
  orders    Order[]
  bonuses   BonusTransaction[]
  bookings  Reservation[]
  sessions  Session[]
}

model Session {
  id        String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuthCode {
  id        String   @id @default(cuid())
  customerId String?
  customer  Customer? @relation(fields: [customerId], references: [id])
  email     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Address {
  id         String  @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  label      String  @default("")
  street     String
  entrance   String  @default("")
  floor      String  @default("")
  apartment  String  @default("")
  comment    String  @default("")
}

model Order {
  id             String   @id @default(cuid())
  number         Int      @unique @default(autoincrement())
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  status         String   @default("new") // new | accepted | cooking | delivering | done | cancelled
  type           String   // delivery | pickup
  items          OrderItem[]
  itemsTotal     Int      // пересчитано на сервере
  deliveryPrice  Int      @default(0)
  bonusSpent     Int      @default(0)
  bonusAccrued   Int      @default(0)
  total          Int
  paymentMethod  String   @default("cash") // cash | online
  paymentStatus  String   @default("none") // none | pending | paid | failed | refunded
  paymentId      String?
  customerName   String
  customerPhone  String
  addressText    String   @default("")
  comment        String   @default("")
  desiredTime    String   @default("") // человекочитаемый текст (обратная совместимость)
  // Структурированная доставка (новое; старые заказы не меняем)
  deliveryMode   String?  // asap | scheduled
  deliveryDate   String?  // локальная дата YYYY-MM-DD
  deliverySlotStart String? // HH:MM
  deliverySlotEnd   String? // HH:MM
  deliveryTz        String? // часовой пояс ресторана
  deliveryOptionName String? // название выбранного варианта
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DeliveryOption {
  id             String  @id
  name           String
  mode           String  // asap | scheduled
  enabled        Boolean @default(true)
  days           Int[]   // 0..6 (вс..сб)
  hoursFrom      String  @default("10:00")
  hoursTo        String  @default("23:00")
  slotMinutes    Int     @default(60)
  minAheadMinutes Int    @default(60)
  daysAhead      Int     @default(7)
  price          Int     @default(0)
  freeFrom       Int?    // порог бесплатности
  exceptions     String[] // даты YYYY-MM-DD закрытых дней
  position       Int     @default(0)
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  dishId      String  // без FK: блюдо может быть удалено из меню, заказ — история
  name        String  // снимок на момент заказа
  price       Int     // снимок цены
  quantity    Int
  modifiers   Json    @default("[]")
  total       Int
}

model BonusTransaction {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  orderId    String?
  type       String   // accrual | spend | reversal | refund
  amount     Int      // положительное — начисление/возврат, отрицательное — списание/сторно
  comment    String   @default("")
  createdAt  DateTime @default(now())
}

model Reservation {
  id            String   @id @default(cuid())
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  status        String   @default("new") // new | confirmed | rejected | cancelled
  date          String   // YYYY-MM-DD
  time          String   // HH:MM
  guests        Int
  customerName  String
  customerPhone String
  comment       String   @default("")
  createdAt     DateTime @default(now())
}

model Promo {
  id         String  @id
  title      String
  text       String  @default("")
  image      String  @default("")
  activeFrom String?
  activeTo   String?
  position   Int     @default(0)
}

model GalleryImage {
  id       String @id @default(cuid())
  image    String
  alt      String @default("")
  position Int    @default(0)
}

model BanquetHall {
  id          String   @id
  name        String
  capacity    String   @default("")
  description String   @default("")
  image       String   @default("") // обложка (первое фото, совместимость)
  images      String[] @default([]) // упорядоченная галерея зала
  position    Int      @default(0)
}

model Page {
  slug     String @id
  title    String
  body     String @default("")
}

model Settings {
  key   String @id
  value Json
}

model MetricsCounter {
  date   String @id // YYYY-MM-DD
  views  Int    @default(0)
}
